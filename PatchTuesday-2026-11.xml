<Sysmon schemaversion="4.90">
  <!--
    ===========================================================================
    Sysmon detection overlay: Microsoft Patch Tuesday, November 2026

        CVE-2026-124194  Outlook spoofing, NTLMv2 hash leak (Exploitation Detected per MSRC;
                         not on CISA KEV as of catalogVersion 2026.11.09)
        CVE-2026-116928  Windows Search RCE reached through Exchange attachment indexing (9.8, zero-click)
        CVE-2026-119958, CVE-2026-118146, CVE-2026-119952
                         LDAP, Active Directory Domain Services and Schannel RCEs (LSASS)
        CVE-2026-109459, CVE-2026-116710, CVE-2026-119963, CVE-2026-119964, CVE-2026-119967
                         Message Queuing RCEs
        CVE-2026-113752  Print Spooler components RCE
        CVE-2026-119961  Internet Information Services RCE
        CVE-2026-121662, CVE-2026-121663
                         Visual Studio Code RCE and security feature bypass (Exploitation More Likely)

    Collects the telemetry the companion Sigma rules and hunts need. It does not
    alert by itself: route RuleName to your SIEM and alert there.

    Merge note: Sysmon runs one config at a time. Merge these RuleGroups into
    your base config (or sysmon-modular) rather than loading this file alone,
    or you lose your baseline coverage.

    Install:  sysmon64 -accepteula -i PatchTuesday-2026-11.xml
    Update:   sysmon64 -c PatchTuesday-2026-11.xml
    Requires Sysmon v15+ (schema 4.90). Every rule is named so the RuleName
    appears in the event.
    ===========================================================================
  -->
  <HashAlgorithms>SHA256,IMPHASH</HashAlgorithms>
  <CheckRevocation>False</CheckRevocation>

  <EventFiltering>

    <!-- ================= ProcessCreate (Event ID 1) ================= -->
    <RuleGroup name="proc-create" groupRelation="or">
      <ProcessCreate onmatch="include">

        <!-- CVE-2026-116928: any child of the Windows Search processes. SearchIndexer normally starts only
             SearchProtocolHost and SearchFilterHost; the Sigma rule filters those out. -->
        <Rule name="CVE-2026-116928-WindowsSearch-child" groupRelation="or">
          <ParentImage condition="end with">\SearchIndexer.exe</ParentImage>
          <ParentImage condition="end with">\SearchProtocolHost.exe</ParentImage>
          <ParentImage condition="end with">\SearchFilterHost.exe</ParentImage>
        </Rule>

        <!-- CVE-2026-124194: the WebClient service fetching from a WebDAV path (the HTTP fallback for a UNC lookup) -->
        <Rule name="CVE-2026-124194-WebDAV-DavSetCookie" groupRelation="and">
          <Image condition="end with">\rundll32.exe</Image>
          <CommandLine condition="contains">davclnt.dll,DavSetCookie</CommandLine>
        </Rule>

        <!-- Crash of a service patched this month: WerFault started by the faulting process -->
        <Rule name="CriticalService-crash-WerFault-2026-11" groupRelation="and">
          <Image condition="end with">\WerFault.exe</Image>
          <ParentImage condition="contains any">\lsass.exe;\mqsvc.exe;\spoolsv.exe;\PrintIsolationHost.exe;\SearchIndexer.exe;\SearchProtocolHost.exe;\SearchFilterHost.exe;\w3wp.exe;\EdgeTransport.exe</ParentImage>
        </Rule>

        <!-- Network-service RCEs: these services should not start interactive tooling -->
        <Rule name="NetworkService-spawns-shell-2026-11" groupRelation="and">
          <ParentImage condition="contains any">\mqsvc.exe;\spoolsv.exe;\PrintIsolationHost.exe;\SearchIndexer.exe;\SearchProtocolHost.exe;\SearchFilterHost.exe</ParentImage>
          <Image condition="contains any">\cmd.exe;\powershell.exe;\pwsh.exe;\rundll32.exe;\regsvr32.exe;\mshta.exe;\wscript.exe;\cscript.exe;\certutil.exe;\bitsadmin.exe;\net.exe;\net1.exe;\whoami.exe</Image>
        </Rule>

        <!-- CVE-2026-121662 / -121663: processes started by Visual Studio Code (high volume on developer machines) -->
        <ParentImage name="CVE-2026-121662-VSCode-child" condition="end with">\Code.exe</ParentImage>

      </ProcessCreate>
    </RuleGroup>

    <!-- ================= NetworkConnect (Event ID 3) ================= -->
    <RuleGroup name="network" groupRelation="or">
      <NetworkConnect onmatch="include">

        <!-- CVE-2026-124194: classic Outlook opening SMB itself. Outlook has no business reaching TCP 445 or 139;
             an external destination means a hash is leaving the network. -->
        <Rule name="CVE-2026-124194-Outlook-SMB-out" groupRelation="and">
          <Image condition="end with">\OUTLOOK.EXE</Image>
          <DestinationPort condition="is any">445;139</DestinationPort>
        </Rule>

        <!-- CVE-2026-124194: the SMB connection a UNC lookup triggers is made by the kernel redirector, which
             Sysmon logs as Image "System" (PID 4), not as OUTLOOK.EXE. Common private ranges are excluded here;
             172.16.0.0/12 and fc00::/7 are left to the Sigma rule's CIDR filter. -->
        <Rule name="NTLM-leak-SMB-out-System" groupRelation="and">
          <Image condition="is">System</Image>
          <DestinationPort condition="is any">445;139</DestinationPort>
          <Initiated condition="is">true</Initiated>
          <DestinationIp condition="not begin with">10.</DestinationIp>
          <DestinationIp condition="not begin with">192.168.</DestinationIp>
          <DestinationIp condition="not begin with">127.</DestinationIp>
          <DestinationIp condition="not begin with">169.254.</DestinationIp>
          <DestinationIp condition="not begin with">fe80:</DestinationIp>
        </Rule>

        <!-- Message Queuing RCEs: all MSMQ service connections (TCP 1801). Matched on the process, not the port,
             because Sysmon can record the listening port as either SourcePort or DestinationPort. -->
        <Image name="MSMQ-mqsvc-connection" condition="end with">\mqsvc.exe</Image>

      </NetworkConnect>
    </RuleGroup>

  </EventFiltering>
</Sysmon>
